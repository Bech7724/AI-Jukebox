# ===== AI Jukebox configuration =====
# Copy this file to `.env` and fill in your values. `.env` is gitignored —
# never commit it, never paste it into docs, logs, or submission archives.

# Base host of the class service network (see class-endpoints.txt).
AIJ_BASE_HOST=http://dobolyi.com

# Class API key — take it from class-endpoints.txt. <your-class-key> is a
# placeholder: the app refuses to run until a real key is set.
AIJ_API_KEY=<your-class-key>

# Service ports (class-endpoints.txt; 9000 is reserved and never used).
AIJ_LLM_PORT=9001
AIJ_IMAGE_PORT=9006
AIJ_MUSIC_PORT=9007
AIJ_TTS_PORT=9008

# Model identifiers (defaults match class-endpoints.txt).
AIJ_LLM_MODEL=cyankiwi/Qwen3.6-35B-A3B-AWQ-4bit
AIJ_IMAGE_MODEL=black-forest-labs/FLUX.2-klein-4B
AIJ_MUSIC_MODEL=acestep-v15-xl-turbo
AIJ_TTS_MODEL=chatterbox-v3

# Local storage for generated songs/covers/DJ audio (default: ./data).
AIJ_DATA_DIR=

# UI host/port/share (launch options).
AIJ_HOST=127.0.0.1
AIJ_PORT=7860
AIJ_SHARE=0
